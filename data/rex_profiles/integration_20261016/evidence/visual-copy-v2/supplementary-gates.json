[
  {
    "label": "clippy-default",
    "command": [
      "cargo",
      "clippy",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "label": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--",
      "--check"
    ],
    "exit_code": 0
  }
]
